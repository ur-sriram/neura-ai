# Google Generative AI (Gemini)
GOOGLE_API_KEY=your_google_api_key_here

# Database (optional, for future persistence)
DATABASE_URL=sqlite:///./ner_logistics.db

# App Configuration
APP_NAME=AI Smart Logistics & Accessibility Platform NER
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","*"]

# Weather API (optional, for real data)
WEATHER_API_KEY=your_weather_api_key_here

# LangChain Tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here

# OpenRouteService — Free routing API (GIScience/openrouteservice on GitHub)
# Sign up FREE (no CC) at: https://account.heigit.org
# Provides: real driving directions, distance matrix, isochrones for NER cities
ORS_API_KEY=

# PyVRP fleet optimizer (PyVRP/PyVRP on GitHub) — no key needed, local solver
# Installed via: pip install pyvrp>=0.8.0
